# =============================================================
#  Variables d'environnement de l'API — copier ce fichier en .env
#  /!\ Le fichier .env ne doit JAMAIS être versionné (cf. .gitignore)
# =============================================================

# Environnement : development | production
NODE_ENV=development
PORT=3001

# --- Base de données (compte en lecture seule créé par 01_create_database.sql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=trouve_ton_artisan
DB_USER=tta_api
DB_PASSWORD=ChangeMe_Str0ng!Pass

# --- Sécurité
# Clé partagée avec le frontend (générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
API_KEY=remplacer_par_une_cle_aleatoire_de_64_caracteres
# Origine(s) autorisée(s) par CORS (séparées par des virgules)
CORS_ORIGIN=http://localhost:5173

# --- E-mails (formulaire de contact)
# Si SMTP_HOST est vide, les e-mails sont simplement affichés dans la console (mode développement).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Trouve ton artisan <no-reply@trouve-ton-artisan.fr>"
