# =============================================================
#  .env de PRODUCTION pour alwaysdata
#  Sur le serveur : cp .env.alwaysdata.example .env  puis  nano .env
#  Remplacez COMPTE par le nom de votre compte alwaysdata.
#  Ne pas mettre PORT ni IP : alwaysdata les fournit automatiquement.
# =============================================================
NODE_ENV=production

# --- Base de données (Bases de données > MySQL dans le panneau alwaysdata)
DB_HOST=mysql-COMPTE.alwaysdata.net
DB_PORT=3306
DB_NAME=COMPTE_tta
# Utilisateur créé avec la permission « lecture seule » (moindre privilège)
DB_USER=COMPTE_api
DB_PASSWORD=mot_de_passe_de_l_utilisateur_api

# --- Sécurité
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=colle_ici_ta_cle_de_64_caracteres
CORS_ORIGIN=https://COMPTE.alwaysdata.net

# --- Le site React compilé est servi par l'API (chemin ABSOLU)
FRONTEND_DIST=/home/COMPTE/trouve-ton-artisan/frontend/dist

# --- E-mails : laisser SMTP_HOST vide = messages affichés dans les logs.
# /!\ Les adresses du jeu d'essai sont fictives mais pourraient exister :
# avant d'activer le SMTP, remplace-les en base par ta propre adresse.
SMTP_HOST=
# SMTP_HOST=smtp-COMPTE.alwaysdata.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Trouve ton artisan <no-reply@COMPTE.alwaysdata.net>"
